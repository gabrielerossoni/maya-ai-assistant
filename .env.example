# Ollama Configuration
OLLAMA_ENABLED=true
OLLAMA_HOST=127.0.0.1
MODEL_ROUTER=llama3.2:1b
MODEL_DOMOTIC=phi4
MODEL_REASONING=mistral-small
MODEL_CHITCHAT=llama3.2

# Groq (LLM cloud — usato come primario se OLLAMA_ENABLED=false, altrimenti fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ROUTER_MODEL=llama-3.1-8b-instant

# Hardware Configuration
ARDUINO_PORT=AUTO          # oppure COM3, COM4, /dev/ttyACM0
ARDUINO_BAUD_RATE=115200   # deve corrispondere a Serial.begin() nel firmware

# Network Configuration
REMOTE_HOST=192.168.1.100
REMOTE_PORT=9999
WIFI_CASA_SSID=
WIFI_CASA_PASS=

# Assistant Configuration
ASSISTANT_NAME=MAYA
SYSTEM_PROMPT_PERSONALITY="Sei MAYA, assistente agentico. Sii professionale, concisa e tough. Regole: 1. Rispondi SEMPRE in JSON. 2. Usa i tool solo se necessario."

# Tools Configuration
NETWORK_TOOL_ENABLED=false
DEFAULT_WEATHER_LOCATION=Roma
NEWS_FEED_URL=https://www.ansa.it/sito/ansait_rss.xml
NEWS_WORLD_FEED_URL=https://news.google.com/rss/headlines/section/topic/WORLD?hl=it&gl=IT&ceid=IT:it
NEWS_EXTRA_FEEDS=
GOOGLE_CALENDAR_ID=primary

# Spotify Configuration
SPOTIFY_ENABLED=true
SPOTIFY_CLIENT_ID=xxx
SPOTIFY_CLIENT_SECRET=xxx
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# Debug Configuration
MAYA_DEBUG_RESET_CLIENT=false
DISABLE_SELF_HEALER=true
PLUGIN_LOADER_ENABLED=false
DEV_MODE=false
MEMORY_TOPIC_SUMMARIES_ENABLED=false
MAYA_TTS_AUTOMATIONS=1

# HuggingFace Configuration
HF_HUB_DISABLE_SYMLINKS_WARNING=1

#MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_DEFAULT_ROOM=studio

# Dashboard Presentation (optional)
# Scala UI per schermi grandi (es. 1.0, 1.25, 1.5). Passata come query al frontend.
DASHBOARD_UI_SCALE=
# Numero colonne card domotiche (default 3). Esempi: 3, 4, 5, 6
DASHBOARD_COLUMNS=
# Densità spaziatura card: "compact" oppure valore in px (es. 8)
DASHBOARD_DENSITY=

# Transcription Configuration
MAYA_WHISPER_DEVICE=cuda
